# Settings for compose.yml. Copy to .env and fill in.
# The full list of options is in the repository's README (Configuration).

# Image version to run; pin it in production (e.g. 0.0.1).
AKILI_VERSION=latest
# Port published on the host.
HOST_PORT=8080

# The URL people and agents use. Agents connect to it and install commands point at it.
AKILI_PUBLIC_URL=https://akili.example.com
# true once served over HTTPS; set false only for a local http://localhost test.
AKILI_COOKIE_SECURE=true

# Required secrets, at least 32 characters each: openssl rand -hex 32
AKILI_JWT_SECRET=
# Encrypts provider keys, integration tokens and the policy-signing key. Back it up: without it,
# stored secrets cannot be read.
AKILI_ENCRYPTION_KEY=

# PostgreSQL password, used by both the database and Akili.
POSTGRES_PASSWORD=

# The first owner account, created on the first start. An empty password is generated and printed
# in the logs: docker compose logs akili | grep password
AKILI_ADMIN_EMAIL=admin@example.com
AKILI_ADMIN_PASSWORD=

# Optional: seeds Claude as the default model provider.
ANTHROPIC_API_KEY=

# Optional: an Akili Enterprise license token (akili-v1.…).
AKILI_LICENSE=

# compose.yml only, for the optional local agent (docker compose --profile agent up -d).
AKILI_JOIN_TOKEN=
