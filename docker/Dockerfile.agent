# Akili agent (Docker install). Hosts managed as servers should use the systemd install instead.
FROM golang:1.27-alpine AS build
ARG VERSION=dev
WORKDIR /src
COPY go.work go.work.sum ./
COPY proto/ proto/
COPY server/go.mod server/go.sum server/
COPY agent/go.mod agent/go.sum agent/
RUN cd agent && go mod download
COPY agent/ agent/
WORKDIR /src/agent
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=${VERSION}" -o /out/akili-agent ./cmd/akili-agent

FROM alpine:3
# Tools the agent commonly shells out to. The agent runs unprivileged.
RUN apk add --no-cache ca-certificates bash curl git jq procps coreutils findutils grep \
 && adduser -D -u 10001 -h /var/lib/akili-agent akili \
 && install -d -o akili -g akili -m 0700 /var/lib/akili-agent
COPY --from=build /out/akili-agent /usr/local/bin/akili-agent
USER 10001
ENV AKILI_STATE_DIR=/var/lib/akili-agent
VOLUME /var/lib/akili-agent
ENTRYPOINT ["akili-agent"]
CMD ["start"]
