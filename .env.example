# Akili control plane settings. Copy to .env: `cp .env.example .env`.
# The server loads ./.env on start (or the file named by AKILI_ENV_FILE); variables already set in the
# real environment take precedence. Never commit .env — it holds secrets.

# ---- Runtime -------------------------------------------------------------------------------------
# development | production. Production refuses short secrets, "*" CORS and the dev defaults below.
AKILI_ENV=development
AKILI_PORT=8080
# Public base URL, used in agent install commands and notification links.
AKILI_PUBLIC_URL=http://localhost:8080
# debug | info | warning | error
AKILI_LOG_LEVEL=info

# ---- Storage -------------------------------------------------------------------------------------
AKILI_DATABASE_URL=postgres://akili:akili@localhost:5433/akili?sslmode=disable
AKILI_REDIS_ADDR=localhost:6380
AKILI_REDIS_PASSWORD=
AKILI_REDIS_DB=0
# Or one URL, which replaces the three above: redis://[user:password@]host:port[/db], or rediss://
# for TLS. Also readable from a file with AKILI_REDIS_URL_FILE.
# AKILI_REDIS_URL=redis://:password@localhost:6380/0
# Host ports docker compose publishes Postgres and Redis on (127.0.0.1 only). Off the standard ports
# so they do not collide with a Postgres/Redis already running on this machine.
AKILI_PG_PORT=5433
AKILI_REDIS_PORT=6380

# ---- Secrets (required in production, at least 32 characters: `openssl rand -hex 32`) -------------
# Signs operator session tokens.
AKILI_JWT_SECRET=
# Encrypts model-provider API keys and the policy-signing key at rest. Changing it later makes those
# unreadable, so set it once and keep it safe.
AKILI_ENCRYPTION_KEY=

# ---- Sessions ------------------------------------------------------------------------------------
AKILI_SESSION_TTL_HOURS=12
# Set to true when served over HTTPS.
AKILI_COOKIE_SECURE=false
# Comma-separated origins allowed to call the API cross-origin (empty = same origin only).
AKILI_CORS_ORIGINS=

# ---- First owner account (created once, on first start) ------------------------------------------
AKILI_ADMIN_EMAIL=admin@akili.local
# Leave empty to generate one and print it once in the server log.
AKILI_ADMIN_PASSWORD=

# ---- Models --------------------------------------------------------------------------------------
# Seeds the default provider on first start. Without it, a scripted development provider is used.
ANTHROPIC_API_KEY=
AKILI_DEFAULT_MODEL=claude-opus-5-5

# ---- Optional ------------------------------------------------------------------------------------
# Slack-compatible incoming webhook for approval requests and task results.
AKILI_NOTIFY_WEBHOOK_URL=
# Serve the UI from disk instead of the embedded build (e.g. server/internal/web/dist).
AKILI_WEB_DIR=
AKILI_OPENAPI_DOCS=true

# ---- MCP gateway ---------------------------------------------------------------------------------
# Executables admins may run as stdio MCP servers (base names). The Miabi preset runs "miabi",
# which the server image includes.
AKILI_MCP_COMMANDS=miabi
# Directory searched before PATH for those executables. Mount it read-only: a binary the server
# could rewrite is refused.
# AKILI_MCP_BIN_DIR=/opt/akili/mcp-bin

# ---- Git identity --------------------------------------------------------------------------------
# Commit name and email of agents without their own ({agent_id}, {agent_name}), and the domains admins
# may give an agent (empty: any). Pushed commits with another author or committer are refused.
# AKILI_GIT_NAME_TEMPLATE=Akili Agent
# AKILI_GIT_EMAIL_TEMPLATE=agent@goakili.dev
# AKILI_GIT_EMAIL_DOMAINS=agents.example.com,users.noreply.github.com

# ---- Network --------------------------------------------------------------------------------------
# CIDRs of reverse proxies whose X-Forwarded-For is trusted (e.g. your ingress: 10.0.0.0/8).
# Empty = forwarded headers are ignored, so clients cannot choose their IP for rate limits and audit.
AKILI_TRUSTED_PROXIES=
# Serve HTTPS directly (otherwise terminate TLS at a proxy). The certificate reloads when the file changes.
# AKILI_TLS_CERT_FILE=/etc/akili/tls.crt
# AKILI_TLS_KEY_FILE=/etc/akili/tls.key
# Agent mTLS (needs the TLS settings above): off | optional | required. Agents then set
# AKILI_CLIENT_CERT_FILE and AKILI_CLIENT_KEY_FILE; browsers are not affected.
# AKILI_AGENT_MTLS=required
# AKILI_AGENT_CLIENT_CA_FILE=/etc/akili/agent-ca.pem

# ---- Encryption at rest (KMS) --------------------------------------------------------------------
# local: AKILI_ENCRYPTION_KEY wraps the data keys. vault-transit: a Vault/OpenBao Transit key does,
# and the database alone never yields a secret. Move with `akili keys rewrap` (keep
# AKILI_ENCRYPTION_KEY set for that one run), then `akili keys rotate`; see README.
# AKILI_KMS=vault-transit
# AKILI_VAULT_ADDR=https://vault.example.com:8200
# AKILI_VAULT_TOKEN=            (or AKILI_VAULT_TOKEN_FILE=/var/run/secrets/vault-token)
# AKILI_VAULT_TRANSIT_MOUNT=transit
# AKILI_VAULT_TRANSIT_KEY=akili
# AKILI_VAULT_NAMESPACE=

# ---- Single sign-on (OpenID Connect) -------------------------------------------------------------
# Redirect URI to register at the provider: <AKILI_PUBLIC_URL>/api/v1/auth/oidc/callback
# AKILI_OIDC_ISSUER=https://login.example.com/realms/main
# AKILI_OIDC_CLIENT_ID=akili
# AKILI_OIDC_CLIENT_SECRET=     (or AKILI_OIDC_CLIENT_SECRET_FILE)
# AKILI_OIDC_NAME=Company SSO
# AKILI_OIDC_SCOPES=openid,email,profile
# Only these email domains may sign in (empty = any verified email).
# AKILI_OIDC_ALLOWED_DOMAINS=example.com
# Role for new users, and group → role mapping from the groups claim (never owner).
# AKILI_OIDC_DEFAULT_ROLE=viewer
# AKILI_OIDC_ROLE_CLAIM=groups
# AKILI_OIDC_ROLE_MAP=akili-admins=admin,akili-ops=operator
# Password sign-in only for the owner (break-glass).
# AKILI_OIDC_DISABLE_PASSWORD=true

# ---- SIEM: stream the audit trail -----------------------------------------------------------------
# Delivered at least once, in order, with each row's hash chain; a sink that was down catches up.
# AKILI_SIEM_WEBHOOK_URL=https://siem.example.com/ingest
# AKILI_SIEM_WEBHOOK_SECRET=    (HMAC: X-Akili-Signature: sha256=<hex>)
# AKILI_SIEM_WEBHOOK_AUTHORIZATION="Splunk <hec-token>"
# AKILI_SIEM_WEBHOOK_FORMAT=json  (json | ndjson)
# AKILI_SIEM_SYSLOG=tls://siem.example.com:6514   (udp:// | tcp:// | tls://, RFC 5424)
# AKILI_SIEM_FILE=-               (a path, or - for stdout)
# AKILI_SIEM_FROM_START=true      (a new sink first receives the whole existing trail)

# ---- Local agent (docker compose --profile agent) ------------------------------------------------
# One-time join token from Agents → Add agent.
AKILI_JOIN_TOKEN=
# Variables passed through to the agent's shell tools (their environment is otherwise scrubbed).
# For kubectl: KUBECONFIG=/Users/you/.kube/config and AKILI_AGENT_SHELL_ENV=
# CA to trust when the control plane uses a self-signed or private-CA certificate: a PEM file, or the
# PEM itself (or base64 of it, for single-line inputs). The agent copies it into its state directory.
# AKILI_CA_CERT=/etc/akili/ca.pem
# AKILI_CA_CERT_PEM=
# Client certificate when the control plane requires agent mTLS.
# AKILI_CLIENT_CERT_FILE=
# AKILI_CLIENT_KEY_FILE=KUBECONFIG
AKILI_AGENT_SHELL_ENV=
# Client certificate when the control plane requires agent mTLS.
# AKILI_CLIENT_CERT_FILE=
# AKILI_CLIENT_KEY_FILE=

# Akili Enterprise license token (akili-v1.…), installed on start when none is stored. Or AKILI_LICENSE_FILE.
# AKILI_LICENSE=
